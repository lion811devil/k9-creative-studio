/* Final mobile stability pass */
@media (max-width: 940px){
  .studio-tabs{position:static!important;top:auto!important;margin:0 0 10px!important;z-index:auto!important}
  .workspace{display:flex!important;flex-direction:column!important}
  .controls{order:1!important}.stage{order:2!important}
}
@media (max-width: 640px){
  body{overflow-x:hidden}
  .app{padding:6px!important}
  .studio-tabs{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:3px!important;padding:4px!important;border-radius:13px!important}
  .studio-tab{min-width:0!important;padding:10px 3px!important;font-size:.70rem!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
  .controls,.preview-panel,.result-panel,.export-card,.export-help{padding:12px!important}
  .section{padding-bottom:13px!important;margin-bottom:13px!important}
  input,select,textarea{font-size:1rem!important;min-height:48px!important;padding:11px 12px!important}
  .btn.primary{min-height:54px!important;font-size:1rem!important}
  .preview-head{min-height:48px!important;padding:0 3px!important;display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:space-between!important;gap:8px!important}
  .preview-head h2{font-size:.90rem!important;white-space:nowrap!important}
  .format-pill{font-size:.70rem!important;padding:6px 9px!important;white-space:nowrap!important}
  .canvas-wrap{padding:7px!important;border-radius:14px!important;background:#0a0e13!important}
  .design-canvas{width:100%!important;height:auto!important;max-width:100%!important;max-height:none!important;border-radius:5px!important}
  .footer{padding:18px 8px!important;font-size:.76rem!important}
}

.fine-tune{margin-top:14px;padding:14px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(145deg,rgba(255,255,255,.035),rgba(255,255,255,.012))}
.fine-tune-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.fine-tune .field{margin:0}
.nudge-pad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(3,42px);justify-content:center;gap:7px;margin:12px 0}.nudge-pad button{border:1px solid #3a414b;background:#20252d;color:#fff;border-radius:10px;font-size:20px;font-weight:900;cursor:pointer}.nudge-pad button:hover{border-color:var(--accent);background:#2a3039}.nudge-pad .up{grid-column:2}.nudge-pad .left{grid-column:1;grid-row:2}.nudge-pad .reset-one{grid-column:2;grid-row:2;font-size:12px}.nudge-pad .right{grid-column:3;grid-row:2}.nudge-pad .down{grid-column:2;grid-row:3}.offset-readout{display:flex;justify-content:center;gap:16px;color:var(--muted);font-size:12px;margin-bottom:10px}.fine-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.fine-actions button{min-height:40px}.safe-note{font-size:12px;line-height:1.45;color:var(--muted);margin-top:8px}
@media(max-width:560px){.fine-tune-grid{grid-template-columns:1fr}.nudge-pad{grid-template-columns:repeat(3,52px)}}

.cta-config{border:1px solid var(--line);background:linear-gradient(145deg,rgba(255,122,0,.055),rgba(255,255,255,.018));border-radius:14px;padding:12px;margin-top:10px}
.checkline{display:flex;align-items:flex-start;gap:9px;padding:9px 10px;border:1px solid var(--line);background:#0f1216;border-radius:10px}
.checkline input{width:auto!important;min-width:18px;height:18px;margin:1px 0 0}
.checkline span{font-size:.79rem;line-height:1.4;color:#d9dde2}
.cta-test-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cta-active-note{font-size:.74rem;line-height:1.45;color:var(--muted);margin-top:8px}
#previewCanvas.cta-ready{cursor:pointer}
#ctaPreviewStatus{margin-top:9px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;background:#101419;color:var(--muted);font-size:.77rem;line-height:1.4}
#ctaPreviewStatus.active{color:#bff4d4;border-color:rgba(82,211,144,.38);background:rgba(82,211,144,.07)}


.logo-free-controls{margin-top:10px;padding:10px;border:1px solid var(--line);border-radius:12px;background:#101419}
.logo-scale-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center}
.logo-scale-row output{min-width:52px;text-align:center;font-weight:900;color:var(--accent)}
#previewCanvas.logo-drag-mode{touch-action:none}
.logo-drag-help{font-size:.72rem;line-height:1.45;color:var(--muted);margin-top:7px}


.all-scale-controls{border:1px solid var(--line);background:#101419;border-radius:12px;padding:11px;margin-top:10px}
.scale-control-row{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center}
.scale-control-row button{min-width:44px;min-height:42px}
.theme-format-row{display:grid;grid-template-columns:1fr auto auto;gap:7px;align-items:end}
.theme-arrow{width:46px;height:44px;padding:0;font-size:1.25rem;border:1px solid var(--line);background:#1a2028;color:#fff;border-radius:11px;font-weight:950}
.theme-arrow:active{transform:scale(.96);background:var(--accent);color:#17100a}
.format-adapt-status{font-size:.72rem;color:#aeb6c1;margin-top:6px;line-height:1.45}
@media(max-width:560px){.theme-format-row{grid-template-columns:1fr 48px 48px}.theme-arrow{width:48px;height:46px}}

.preview-theme-toolbar{display:grid;grid-template-columns:52px 1fr 52px;gap:10px;align-items:center;margin:12px 0 14px}
.preview-theme-toolbar button{width:52px;height:52px;border-radius:14px;border:1px solid var(--line);background:#161c23;color:#fff;font-size:1.9rem;font-weight:950}
.preview-theme-toolbar button:active{transform:scale(.95);background:var(--accent);color:#1b1107}
.preview-theme-info{text-align:center;padding:9px 12px;border:1px solid var(--line);border-radius:13px;background:#101419;min-width:0}
.preview-theme-name{display:block;font-weight:950;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.preview-theme-counter{display:block;margin-top:3px;font-size:.72rem;color:var(--muted)}
.preview-theme-options{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 12px}
.preview-graphic-toolbar{display:grid;grid-template-columns:52px 1fr 52px;gap:10px;align-items:center;margin:12px 0 7px}.preview-graphic-toolbar button{width:52px;height:52px;border-radius:14px;border:1px solid rgba(216,171,77,.42);background:linear-gradient(145deg,#201b13,#12171d);color:var(--gold);font-size:1.9rem;font-weight:950}.preview-graphic-toolbar button:active{transform:scale(.95);background:var(--gold);color:#17100a}.preview-graphic-info{text-align:center;padding:9px 12px;border:1px solid rgba(216,171,77,.32);border-radius:13px;background:#111419;min-width:0}.preview-graphic-name{display:block;font-weight:950;color:#f0d29a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.preview-graphic-counter{display:block;margin-top:3px;font-size:.72rem;color:var(--muted)}.selector-caption{text-align:center;color:var(--muted);font-size:.7rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase;margin:1px 0 3px}@media(max-width:560px){.preview-graphic-toolbar{grid-template-columns:48px 1fr 48px;gap:7px}.preview-graphic-toolbar button{width:48px;height:48px}}
.arrow-system-status{margin-top:10px;padding:9px 11px;border-radius:10px;border:1px solid rgba(82,211,144,.3);background:rgba(82,211,144,.06);color:#c8f5dc;font-size:.74rem}
@media(max-width:560px){.preview-theme-toolbar{grid-template-columns:48px 1fr 48px;gap:7px}.preview-theme-toolbar button{width:48px;height:48px}.preview-theme-options{grid-template-columns:1fr}}

.render-fallback{position:absolute;inset:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:24px;text-align:center;border-radius:18px;background:#10151b;color:#fff;border:1px solid #37414d;z-index:3}
.render-fallback span{color:var(--muted);font-size:.9rem}
.canvas-wrap{position:relative}
.hidden{display:none!important}
.preview-theme-toolbar{display:grid;grid-template-columns:52px minmax(0,1fr) 52px;gap:10px;align-items:center;margin:12px 0}
.preview-theme-toolbar button{height:52px;border-radius:14px;border:1px solid var(--line);background:#171d24;color:#fff;font-size:2rem;font-weight:900}
.preview-theme-info{text-align:center;min-width:0;padding:8px 10px;border-radius:13px;border:1px solid var(--line);background:#0e1318}
.preview-theme-name{display:block;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.preview-theme-counter{display:block;color:var(--muted);font-size:.75rem;margin-top:2px}
.preview-theme-options{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
@media(max-width:560px){.preview-theme-options{grid-template-columns:1fr}.preview-theme-toolbar{grid-template-columns:48px minmax(0,1fr) 48px}.preview-theme-toolbar button{height:48px}}

.multi-logo-manager{border:1px solid var(--line);border-radius:20px;padding:18px;background:#10151b;margin-bottom:18px}
.multi-logo-manager .danger{border-color:rgba(255,92,92,.5);color:#ffb1b1}
